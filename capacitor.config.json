{
  "appId": "com.strkyr.app",
  "appName": "STRKYR",
  "webDir": "public",
  "server": {
    "url": "https://strkyr.fit",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#0f172a",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  },
  "ios": {
    "contentInset": "always",
    "preferredContentMode": "mobile",
    "scheme": "STRKYR"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f172a"
  }
}
