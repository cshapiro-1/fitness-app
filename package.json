{
  "name": "fitness-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "ci:check": "vitest run && tsc --noEmit && next build",
    "ship": "npm run ci:check && git push origin main:main && git push origin main:master",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:api": "bru run bruno --env local",
    "test:api:staging": "bru run bruno --env staging",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && tsc --noEmit",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "stripe:setup": "tsx scripts/setup-stripe.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@neondatabase/serverless": "^1.1.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@prisma/config": "^7.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@usebruno/cli": "^1.38.0",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
