generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  CLIENT
  USER
  admin
  trainer
  client
  user
}

enum InviteStatus {
  NOT_SENT
  PENDING
  ACCEPTED
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  trainerId    String?
  notes        String?
  fitnessGoals String?
  phone        String?
  id                 String    @id @default(cuid())
  email        String?    @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  role               UserRole  @default(TRAINER)
  clientProfileId    String?   @unique
  isAdmin            Boolean   @default(false)
  subscriptionStatus String?   @default("trial")
  subscriptionProvider String? @default("stripe")
  subscriptionId     String?
  originalTransactionId String?
  trialEndsAt        DateTime?
  subscribedUntil    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt

  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  clientProfile Client?   @relation("ClientLogin", fields: [clientProfileId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role])
}

model Client {
  id           String       @id @default(cuid())
  userId       String
  name         String
  email        String?      @unique
  phone        String?
  notes        String?
  fitnessGoals String?
  createdAt    DateTime     @default(now())

  inviteToken  String?      @unique
  inviteStatus InviteStatus @default(NOT_SENT)
  invitedAt    DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  workoutSessions WorkoutSession[]
  loginUser       User?            @relation("ClientLogin")

  @@index([userId])
  @@index([inviteToken])
  @@index([email])
}

model Workout {
  id        String   @id @default(cuid())
  clientId  String
  exercise  String
  weight    Float
  sets      Int
  reps      Int
  date      String
  notes     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model WorkoutSession {
  id          String               @id @default(cuid())
  clientId    String
  status      WorkoutSessionStatus @default(COMPLETED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]

  @@index([clientId])
  @@index([status])
  @@index([completedAt])
}

model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  name             String
  order            Int
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sets             WorkoutSet[]

  @@index([workoutSessionId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  order             Int
  weight            Float
  reps              Int
  notes             String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String?
  trainerId String
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
}
