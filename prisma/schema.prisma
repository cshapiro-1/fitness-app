generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRAINER
  CLIENT
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  emailVerified DateTime?
  name      String?
  image     String?
  role      UserRole  @default(TRAINER)
  clientProfileId String? @unique
  accounts  Account[]
  sessions  Session[]
  clients   Client[]
  clientProfile Client? @relation("ClientLogin", fields: [clientProfileId], references: [id], onDelete: SetNull)
}

model Client {
  id        String    @id @default(cuid())
  userId    String
  name      String
  email     String?   @unique
  notes     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts  Workout[]
  workoutSessions WorkoutSession[]
  loginUser User?     @relation("ClientLogin")
}

model Workout {
  id        String   @id @default(cuid())
  clientId  String
  exercise  String
  weight    Float
  sets      Int
  reps      Int
  date      String
  notes     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id          String            @id @default(cuid())
  clientId    String
  status      WorkoutSessionStatus @default(COMPLETED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id               String       @id @default(cuid())
  workoutSessionId String
  name             String
  order            Int
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sets             WorkoutSet[]
}

model WorkoutSet {
  id                String        @id @default(cuid())
  workoutExerciseId String
  order             Int
  weight            Float
  reps              Int
  notes             String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}
