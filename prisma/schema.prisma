generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  CLIENT
  USER
  admin
  trainer
  client
  user
}

enum InviteStatus {
  NOT_SENT
  PENDING
  ACCEPTED
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  trainerId             String?
  notes                 String?
  fitnessGoals          String?
  phone                 String?
  id                    String    @id @default(cuid())
  email                 String?   @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  role                  UserRole  @default(TRAINER)
  clientProfileId       String?   @unique
  isAdmin               Boolean   @default(false)
  subscriptionStatus    String?   @default("trial")
  subscriptionProvider  String?   @default("stripe")
  subscriptionId        String?
  originalTransactionId String?
  trialEndsAt           DateTime?
  subscribedUntil       DateTime?
  emailNotifications    Boolean   @default(true)
  hasCompletedOnboarding Boolean  @default(false)
  hasSeenTour           Boolean   @default(false)
  lastLoginAt           DateTime? @default(now())
  lastActiveAt          DateTime? @default(now())
  lastSessionDurationSeconds Int? @default(0)
  loginCount            Int?      @default(1)
  totalSessionSeconds   Int?      @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt

  accounts       Account[]
  sessions       Session[]
  clients        Client[]
  clientProfile  Client?          @relation("ClientLogin", fields: [clientProfileId], references: [id], onDelete: SetNull)
  loggedWorkouts WorkoutSession[] @relation("LoggedWorkouts")

  @@index([email])
  @@index([role])
}

model Client {
  id                 String       @id @default(cuid())
  userId             String
  name               String
  image              String?
  email              String?      @unique
  phone              String?
  notes              String?
  fitnessGoals       String?
  emailNotifications Boolean      @default(true)
  lastActiveAt       DateTime?    @default(now())
  lastSessionDurationSeconds Int? @default(0)
  loginCount         Int?         @default(1)
  totalSessionSeconds Int?        @default(0)
  createdAt          DateTime     @default(now())

  inviteToken  String?      @unique
  inviteStatus InviteStatus @default(NOT_SENT)
  invitedAt    DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  workoutSessions WorkoutSession[]
  nutritionPlan   NutritionPlan?
  nutritionLogs   NutritionLog[]
  supplementLogs  SupplementLog[]
  loginUser       User?            @relation("ClientLogin")

  @@index([userId])
  @@index([inviteToken])
  @@index([email])
}

model Workout {
  id           String   @id @default(cuid())
  clientId     String
  exercise     String
  weight       Float
  sets         Int
  reps         Int
  date         String
  notes        String?
  loggedByRole String?  @default("TRAINER")
  loggedById   String?
  loggedByName String?
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model WorkoutSession {
  id           String               @id @default(cuid())
  clientId     String
  status       WorkoutSessionStatus @default(COMPLETED)
  sessionType  String?              @default("WORKOUT") // WORKOUT, REST_DAY, CARDIO, WELLNESS
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  loggedByRole String?              @default("TRAINER") // TRAINER, CLIENT
  loggedById   String?
  loggedByName String?
  deletedAt    DateTime?
  deletedByName String?
  deletedByRole String?
  createdAt    DateTime             @default(now())
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loggedByUser User?                @relation("LoggedWorkouts", fields: [loggedById], references: [id], onDelete: SetNull)
  exercises    WorkoutExercise[]

  @@index([clientId])
  @@index([status])
  @@index([completedAt])
  @@index([loggedById])
  @@index([loggedByRole])
}

model WorkoutExercise {
  id               String          @id @default(cuid())
  workoutSessionId String
  name             String
  order            Int
  category         String?         @default("STRENGTH") // STRENGTH, BODYWEIGHT, CARDIO, STRETCHING, WELLNESS
  workoutSession   WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sets             WorkoutSet[]

  @@index([workoutSessionId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  order             Int
  weight            Float
  reps              Int
  distance          Float?          // Miles/km for cardio
  durationSeconds   Int?            // Seconds for cardio/stretching
  notes             String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

model NutritionPlan {
  id            String   @id @default(cuid())
  clientId      String   @unique
  goalType      String   @default("CUT") // CUT, BULK, MAINTAIN, RECOMP
  dailyCalories Int      @default(2000)
  proteinGrams  Int      @default(150)
  carbsGrams    Int      @default(200)
  fatsGrams     Int      @default(65)
  waterOz       Int?     @default(100)
  currentWeight Float?
  targetWeight  Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model NutritionLog {
  id        String   @id @default(cuid())
  clientId  String
  date      String   // YYYY-MM-DD
  mealName  String   // Breakfast, Lunch, Dinner, Snack, Post-Workout
  foodName  String
  calories  Int
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fats      Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model SupplementLog {
  id        String   @id @default(cuid())
  clientId  String
  date      String   // YYYY-MM-DD
  name      String
  dosage    String?  // e.g. 5g, 1 scoop, 2 capsules
  timing    String?  // Morning, Pre-Workout, Post-Workout, Bedtime
  taken     Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model Invitation {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String?
  trainerId String
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Exercise {
  id               String   @id @default(cuid())
  name             String   @unique
  normalizedName   String   @unique
  type             String   @default("EXERCISE") // EXERCISE, STRETCH, MOBILITY, CARDIO, WELLNESS
  muscleGroup      String   @default("Chest")
  equipment        String   @default("Bodyweight")
  category         String   @default("STRENGTH") // STRENGTH, BODYWEIGHT, CARDIO, STATIC_STRETCH, DYNAMIC_WARMUP, FOAM_ROLL, WELLNESS
  primaryMuscles   String   @default("[]") // JSON string of primary muscle array
  secondaryMuscles String   @default("[]") // JSON string of secondary muscle array
  biomechanicsCue  String?
  steps            String?  // JSON string array of execution steps
  commonMistakes   String?  // JSON string array of common mistakes
  breathingPattern String?
  diagramUrl       String?  // Path or URL to validated anatomical illustration
  diagramStatus    String   @default("PENDING_APPROVAL") // APPROVED, PENDING_APPROVAL, REJECTED, NEEDS_REVISION
  diagramNotes     String?
  approvedByUserId String?
  approvedAt       DateTime?
  createdByUserId  String?
  createdByUserRole String? @default("SYSTEM") // SYSTEM, TRAINER, ADMIN
  isCustom         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([muscleGroup])
  @@index([type])
  @@index([diagramStatus])
  @@index([normalizedName])
}
