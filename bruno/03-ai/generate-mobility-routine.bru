meta {
  name: AI Mobility Routine Generator
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ai/generate-routine
  body: json
  auth: none
}

body:json {
  {
    "sessionType": "MOBILITY",
    "muscleGroups": ["Chest", "Shoulders"],
    "routineType": "warmup",
    "durationMinutes": 10,
    "perStretchSeconds": 60
  }
}

assert {
  res.status: in [200, 401]
}
